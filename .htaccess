Options -Indexes
RewriteEngine On

# Keep sensitive files private.
<FilesMatch "^(config\.php|schema\.sql)$">
  Require all denied
</FilesMatch>

# Let Apache serve existing assets and uploaded files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Media proxy (protected images/videos)
RewriteRule ^serve$ serve.php [QSA,L]

# SEO endpoints
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# All application routes go to the PHP front controller.
RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
